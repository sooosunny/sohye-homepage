{
  "name": "jinalee-academic-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate:cv": "python3 scripts/cv/parse_docx.py --input public/cv.docx --output src/generated/cv-data.json",
    "refresh:publications": "npm run generate:cv",
    "generate:pages": "python3 scripts/cv/refresh_page_sources.py",
    "refresh:pages": "npm run generate:pages",
    "refresh:page:home": "python3 scripts/cv/refresh_page_sources.py --pages home",
    "refresh:page:research": "python3 scripts/cv/refresh_page_sources.py --pages research",
    "refresh:page:teaching": "python3 scripts/cv/refresh_page_sources.py --pages teaching",
    "refresh:page:publications": "python3 scripts/cv/refresh_page_sources.py --pages publications",
    "refresh:page:cv": "python3 scripts/cv/refresh_page_sources.py --pages cv",
    "generate:content": "python3 scripts/cv/parse_site_content.py --input site-content.docx --output src/generated/site-content.json",
    "generate:content:ko": "python3 scripts/cv/create_korean_site_content.py --input site-content.docx --output site-content-ko.docx && python3 scripts/cv/parse_site_content.py --input site-content-ko.docx --output src/generated/site-content-ko.json",
    "refresh:site-content": "npm run generate:content && npm run generate:content:ko && npm run check:content-sync",
    "check:content-sync": "python3 scripts/cv/check_content_sync.py",
    "refresh:content": "npm run generate:cv && npm run generate:content && npm run generate:content:ko && npm run check:content-sync",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "next": "^15.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.61.1",
    "react-grab": "^0.1.48",
    "react-scan": "^0.5.7",
    "typescript": "^5.2.2"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
